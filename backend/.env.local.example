# Local development auth (Ticket 004)
# Copy to backend/.env.local and adjust values for your machine.
# Default local login from task fallback: username devadmin, password localdev123

AUTH_ENABLED=1
AUTH_ADMIN_USERNAME=devadmin
AUTH_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$6RM4GnJvTWhMKn2FXhOMPQ$2FVlFoswNN5Wj+9DvysKmPi6Xjx3DF8lDuWUB1j7fDY'
AUTH_SESSION_SECRET='dev-session-secret-change-me'
AUTH_SESSION_MAX_AGE_SECONDS=28800
AUTH_COOKIE_SECURE=0
AUTH_LOGIN_LIMIT_PER_MINUTE=20

# Existing backend local defaults (override if needed)
LMSTUDIO_TIMEOUT=360
ENABLE_SCRAPING=0
CV_DEBUG_TEX=1

# Comma-separated allowlist of browser origins for API CORS.
# Default in code is http://localhost:5173 when this is not set.
CORS_ALLOW_ORIGINS=http://localhost:5173
